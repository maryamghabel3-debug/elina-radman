    { "id": "p1_l5", "start": 6.5, "end": 10.05, "speaker": "eli", "text": "همین؟! فقط باشه؟ نه سلامی، نه استیکری، نه هیچی؟", "eliPose": "suspicious", "elinaPose": "concerned" },
    { "id": "p1_l6", "start": 10.05, "end": 12, "speaker": "elina", "text": "نه... فقط همین.", "eliPose": "suspicious", "elinaPose": "concerned" }
